<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap newsletter">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', class: 'nl-form', id: 'nl-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="nl-email">Your email</label>
      <input id="nl-email" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required value="{{ form.email }}">
      <button type="submit">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p class="form-msg ok nl-msg" role="status">Thanks for subscribing!</p>
      {%- elsif form.errors -%}
        <p class="form-msg err nl-msg" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign up for the newsletter" },
    { "type": "text", "id": "text", "label": "Text", "default": "New pieces, restocks and offers, straight to your inbox." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Submit" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
