<section class="section image-banner" {{ section.shopify_attributes }}>
  <div class="wrap" style="max-width:1200px">
    {%- capture banner -%}
      {%- render 'theme-image', image: section.settings.image, asset: 'community-instagram.webp', alt: section.settings.alt, width: 1400, ratio_w: 1400, ratio_h: 882 -%}
    {%- endcapture -%}
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}"{% if section.settings.link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ banner }}</a>
    {%- else -%}
      {{ banner }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the bundled Instagram community banner." },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Follow us and be part of the community, #CIELALOVERS, follow us on Instagram" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
