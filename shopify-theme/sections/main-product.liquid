{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_image = current_variant.featured_image | default: product.featured_image
-%}
<section class="section" id="product" style="padding-top:clamp(32px,4vw,56px)" data-product-section {{ section.shopify_attributes }}>
  <div class="wrap">
    <p class="crumbs" style="margin:0 0 28px">
      <a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- if collection %} / <a href="{{ collection.url }}">{{ collection.title }}</a>{% endif %} / {{ product.title }}
    </p>

    <div class="pdp">
      <div class="pdp-gallery">
        <div class="pdp-main">
          {%- if first_image -%}
            <img id="pdp-img" src="{{ first_image | image_url: width: 1000 }}" srcset="{{ first_image | image_url: width: 600 }} 600w, {{ first_image | image_url: width: 1000 }} 1000w, {{ first_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 820px) 50vw, 100vw" alt="{{ first_image.alt | default: product.title | escape }}" width="800" height="1000">
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="thumbs">
            {%- for image in product.images limit: 8 -%}
              <button type="button" class="thumb" data-src="{{ image | image_url: width: 1000 }}" data-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1600 }} 1600w" data-id="{{ image.id }}" aria-label="Show photo {{ forloop.index }}" aria-current="{% if image.id == first_image.id %}true{% else %}false{% endif %}">
                <img src="{{ image | image_url: width: 160 }}" alt="" width="120" height="150" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp-info">
        {%- if product.type != blank -%}<span class="eyebrow">{{ product.type }}</span>{%- endif -%}
        <h1 class="h2" style="margin:0">{{ product.title }}</h1>
        <p class="pdp-price" id="pdp-price">
          {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money_with_currency }}</s> {% endif -%}
          {{- current_variant.price | money_with_currency -}}
        </p>

        {%- form 'product', product, id: 'product-form', class: 'pdp-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {%- unless product.has_only_default_variant -%}
            <div id="pdp-options">
              {%- for option in product.options_with_values -%}
                <fieldset class="opt">
                  <legend class="label">{{ option.name }}: <strong>{{ option.selected_value }}</strong></legend>
                  <div class="chips">
                    {%- for value in option.values -%}
                      <button type="button" class="chip" data-option-index="{{ forloop.parentloop.index0 }}" data-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="pdp-buy">
            <label class="sr-only" for="pdp-qty">{{ 'products.quantity' | t }}</label>
            <input id="pdp-qty" class="qty" type="number" name="quantity" min="1" max="10" value="1">
            <button class="btn" type="submit" id="pdp-add" {% unless current_variant.available %}aria-disabled="true" disabled{% endunless %}>
              {%- if current_variant.available -%}{{ 'products.add_to_bag' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
            </button>
          </div>
          <p class="form-msg" id="pdp-msg" role="status" aria-live="polite"></p>
        {%- endform -%}

        <div class="pdp-notify" id="pdp-notify"{% if current_variant.available %} hidden{% endif %}>
          {%- form 'contact', id: 'notify-form', class: 'notify-form' -%}
            <input type="hidden" name="contact[tags]" value="back-in-stock">
            <input type="hidden" name="contact[body]" value="Back in stock request: {{ product.title | escape }} ({{ current_variant.title | escape }}) {{ shop.url }}{{ product.url }}" data-notify-body data-product="{{ product.title | escape }}" data-url="{{ shop.url }}{{ product.url }}">
            <span class="label">Notify me when it is back in stock</span>
            <div class="nl-form">
              <label class="sr-only" for="notify-email">Your email</label>
              <input id="notify-email" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required>
              <button type="submit">Notify me</button>
            </div>
            {%- if form.posted_successfully? -%}<p class="form-msg ok" role="status">Thanks! We will email you as soon as it is back.</p>{%- endif -%}
            {%- if form.errors -%}<p class="form-msg err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          {%- endform -%}
        </div>

        <button type="button" class="pdp-share" data-share data-url="{{ shop.url }}{{ product.url }}">Share <span class="sr-only">this piece</span></button>

        <ul class="pdp-perks">
          <li>Ships from the USA</li>
          <li>Secure checkout</li>
          <li>Free shipping on selected orders</li>
        </ul>

        <div class="pdp-desc rte">{{ product.description }}</div>

        <details class="policy">
          <summary>Shipping</summary>
          <p>{{ section.settings.shipping_text }} <a href="{{ shop.shipping_policy.url }}">Shipping policy</a></p>
        </details>
        <details class="policy">
          <summary>Returns</summary>
          <p>See our <a href="{{ shop.refund_policy.url }}">refund policy</a> for details on returns and exchanges.</p>
        </details>
      </div>
    </div>
  </div>

  <script type="application/json" id="product-json">
    {
      "product": {
        "url": {{ product.url | json }},
        "title": {{ product.title | json }},
        "image": {{ product.featured_image | image_url: width: 500 | json }},
        "image2": {% if product.images[1] %}{{ product.images[1] | image_url: width: 500 | json }}{% else %}null{% endif %},
        "price": {{ product.price | money_with_currency | json }},
        "available": {{ product.available | json }}
      },
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | money_with_currency | json }},
            "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_with_currency | json }}{% else %}null{% endif %},
            "image": {% if variant.featured_image %}{{ variant.featured_image.id | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "soldOut": {{ 'products.sold_out' | t | json }},
      "addToBag": {{ 'products.add_to_bag' | t | json }},
      "selectOptions": {{ 'products.select_options' | t | json }},
      "optionSoldOut": {{ 'products.option_sold_out' | t | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping note",
      "default": "International shipments from USA. Free shipping on selected orders; taxes and customs fees are not included."
    }
  ]
}
{% endschema %}
