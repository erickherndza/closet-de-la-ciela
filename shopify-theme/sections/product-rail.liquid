{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['all']
  endif
-%}
<section class="section" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank -%}
    <div class="section-head"><span class="pill">{{ section.settings.heading }}</span></div>
  {%- endif -%}
  <div class="rail-wrap">
    <div class="rail">
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, badge: section.settings.badge %}
      {%- else -%}
        <p class="empty">No products yet.</p>
      {%- endfor -%}
    </div>
    <div class="rail-progress" aria-hidden="true"><span></span></div>
    <div class="rail-ctrl">
      <button type="button" class="hs-btn" data-rail="prev" aria-label="Previous products">{% render 'icon', name: 'prev' %}</button>
      <button type="button" class="hs-btn" data-rail="next" aria-label="Next products">{% render 'icon', name: 'next' %}</button>
    </div>
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="section-head" style="margin:32px 0 0"><a class="btn btn-ghost" href="{{ section.settings.button_link | default: col.url }}">{{ section.settings.button_label }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "badge", "label": "Badge on each piece", "default": "New" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all jewelry" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
