<section class="hs-section" {{ section.shopify_attributes }}>
  <div class="hs" role="region" aria-roledescription="carousel" aria-label="Featured collections">
    <div class="hs-track" aria-live="off">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_full = false
          if block.settings.layout == 'full'
            assign is_full = true
          endif
          assign asset = block.settings.default_asset
        -%}
        <article class="hs-slide{% if forloop.first %} is-active{% endif %}{% if is_full %} hs-full{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" style="background:{{ block.settings.bg }}" {{ block.shopify_attributes }}>
          {%- if is_full -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" aria-label="{{ block.settings.title | strip_html | escape }}" style="display:block;position:absolute;inset:0">
              {%- render 'theme-image', image: block.settings.image, asset: asset, alt: block.settings.alt, width: 2400, loading: 'eager', style: block.settings.object_position -%}
              {%- if block.settings.button != blank -%}<span class="btn hs-full-cta">{{ block.settings.button }}</span>{%- endif -%}
            </a>
          {%- else -%}
            <div class="hs-text">
              {%- if block.settings.eyebrow != blank -%}<span class="hs-eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
              {%- if block.settings.title != blank -%}<h2 class="hs-title">{{ block.settings.title }}</h2>{%- endif -%}
              {%- if block.settings.copy != blank -%}<p class="hs-copy">{{ block.settings.copy }}</p>{%- endif -%}
              {%- if block.settings.button != blank -%}<a class="btn" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button }}</a>{%- endif -%}
            </div>
            <div class="hs-media">
              {%- render 'theme-image', image: block.settings.image, asset: asset, alt: block.settings.alt, width: 1600, loading: 'lazy', sizes: '(min-width: 820px) 50vw, 100vw', style: block.settings.object_position -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="hs-ctrl">
        <div class="hs-dots">
          {%- for block in section.blocks -%}
            <button type="button" class="hs-dot" aria-label="Go to slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
        <div class="hs-arrows">
          <button type="button" class="hs-btn hs-prev" aria-label="Previous slide">{% render 'icon', name: 'prev' %}</button>
          <button type="button" class="hs-btn hs-next" aria-label="Next slide">{% render 'icon', name: 'next' %}</button>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero slider",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "split", "label": "Text + image" },
            { "value": "full", "label": "Full-width image (text is part of the image)" }
          ],
          "default": "split"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "default_asset",
          "label": "Bundled image (used if no image is uploaded)",
          "options": [
            { "value": "hero-welcome.jpg", "label": "Welcome to our closet" },
            { "value": "necklaces-layered.webp", "label": "Layered necklaces" },
            { "value": "rings-stacked.webp", "label": "Stacked rings" },
            { "value": "slide-rainbow.webp", "label": "Rainbow necklace" }
          ],
          "default": "necklaces-layered.webp"
        },
        { "type": "text", "id": "alt", "label": "Image description (alt text)" },
        { "type": "text", "id": "object_position", "label": "Image position (CSS)", "info": "Example: object-position:50% 30%" },
        { "type": "color", "id": "bg", "label": "Background", "default": "#CFE6E3" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "inline_richtext", "id": "title", "label": "Title", "info": "Use italic for the accent words." },
        { "type": "textarea", "id": "copy", "label": "Text" },
        { "type": "text", "id": "button", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide", "settings": { "layout": "full", "default_asset": "hero-welcome.jpg", "bg": "#E8A9D6", "alt": "Model wearing pavé hoop earrings against a pink and lilac backdrop", "object_position": "object-position:50% 62%", "title": "Welcome to our closet", "button": "Shop new favorites" } },
        { "type": "slide", "settings": { "default_asset": "necklaces-layered.webp", "bg": "#CFE6E3", "eyebrow": "Necklaces", "title": "Layer, stack <em>and mix</em>", "copy": "Find your new favorites in 14K–18K gold, 925 sterling silver and moissanite, shipped from the USA.", "button": "Shop necklaces" } },
        { "type": "slide", "settings": { "default_asset": "rings-stacked.webp", "bg": "#F3DDEC", "eyebrow": "Rings", "title": "Stack them, <em>love them</em>", "copy": "Slim bezel-set bands made to be worn together. Everyday sparkle that goes with everything.", "button": "Shop rings" } },
        { "type": "slide", "settings": { "default_asset": "slide-rainbow.webp", "bg": "#DCE6F5", "eyebrow": "New color", "title": "A little <em>rainbow</em> for every day", "copy": "Playful color for your neckline, in delicate pieces that go with everything.", "button": "Discover new arrivals", "object_position": "object-fit:contain;object-position:50% 50%" } }
      ]
    }
  ]
}
{% endschema %}
