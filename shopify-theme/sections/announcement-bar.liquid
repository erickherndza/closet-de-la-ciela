<div class="announce" role="region" aria-label="Store announcements" {{ section.shopify_attributes }}>
  <div class="announce-track">
    {%- for block in section.blocks -%}
      <p class="{% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on selected orders" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on selected orders" } },
        { "type": "message", "settings": { "text": "International shipping from USA" } },
        { "type": "message", "settings": { "text": "14K–18K gold · 925 sterling silver · Moissanite" } }
      ]
    }
  ]
}
{% endschema %}
