<footer class="site-footer" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="{{ 'logo-closet-de-la-ciela.webp' | asset_url }}" width="180" height="46" alt="{{ shop.name | escape }}">
        {%- if settings.tagline != blank -%}<p>{{ settings.tagline }}</p>{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
          <ul>
            {%- case block.type -%}
              {%- when 'links' -%}
                {%- for i in (1..6) -%}
                  {%- assign label_key = 'label_' | append: i -%}
                  {%- assign link_key = 'link_' | append: i -%}
                  {%- assign label = block.settings[label_key] -%}
                  {%- if label != blank -%}
                    <li><a href="{{ block.settings[link_key] | default: routes.root_url }}">{{ label }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- when 'social' -%}
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
              {%- when 'policies' -%}
                {%- for policy in shop.policies -%}
                  <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
                {%- endfor -%}
            {%- endcase -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if section.settings.note != blank -%}<span>{{ section.settings.note }}</span>{%- endif -%}
    </div>
    {%- if settings.credit_name != blank -%}
      <p class="dev-credit">{{ settings.credit_text }} <a href="{{ settings.credit_url }}" target="_blank" rel="noopener">{{ settings.credit_name }}</a></p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "note", "label": "Bottom note", "default": "Free shipping excludes taxes and international customs fees" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "text", "id": "label_1", "label": "Label 1", "default": "All jewelry" },
        { "type": "url", "id": "link_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Label 2" },
        { "type": "url", "id": "link_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Label 3" },
        { "type": "url", "id": "link_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Label 4" },
        { "type": "url", "id": "link_4", "label": "Link 4" },
        { "type": "text", "id": "label_5", "label": "Label 5" },
        { "type": "url", "id": "link_5", "label": "Link 5" },
        { "type": "text", "id": "label_6", "label": "Label 6" },
        { "type": "url", "id": "link_6", "label": "Link 6" }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us" }
      ]
    },
    {
      "type": "policies",
      "name": "Store policies",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Policies" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "links" },
        { "type": "social" },
        { "type": "policies" }
      ]
    }
  ]
}
{% endschema %}
