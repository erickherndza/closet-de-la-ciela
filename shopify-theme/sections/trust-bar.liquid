<div class="trust" {{ section.shopify_attributes }}>
  <div class="wrap">
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "14K–18K gold" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "text": "14K–18K gold" } },
        { "type": "item", "settings": { "text": "925 sterling silver" } },
        { "type": "item", "settings": { "text": "Moissanite & zirconia" } },
        { "type": "item", "settings": { "text": "Ships from the USA" } }
      ]
    }
  ]
}
{% endschema %}
