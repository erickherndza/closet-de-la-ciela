<section class="section" data-recent hidden {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="section-head"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    <div class="grid" data-recent-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" }
  ]
}
{% endschema %}
