{%- comment -%} Params: product, badge (optional label shown when the piece is available) {%- endcomment -%}
<a class="card" href="{{ product.url }}">
  <div class="card-media">
    {%- if product.available == false or badge != blank or product.tags contains 'new' or product.compare_at_price > product.price -%}
      <div class="card-badges">
        {%- if product.available == false -%}
          <span class="badge sold">{{ 'products.sold_out' | t }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          <span class="badge">Sale</span>
        {%- elsif badge != blank -%}
          <span class="badge">{{ badge }}</span>
        {%- elsif product.tags contains 'new' -%}
          <span class="badge">{{ 'products.new' | t }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 800 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 800 }} 800w" sizes="(min-width: 960px) 22vw, 62vw" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="1000">
    {%- endif -%}
    {%- if product.images[1] -%}
      <img class="alt" src="{{ product.images[1] | image_url: width: 800 }}" alt="" loading="lazy" width="800" height="1000">
    {%- endif -%}
  </div>
  <div class="card-info">
    <span class="card-title">{{ product.title }}</span>
    <span class="card-price">
      {%- if product.price_varies %}{{ 'products.from' | t }} {% endif -%}
      {{ product.price | money_with_currency }}
    </span>
  </div>
</a>
