<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_deep }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ 'logo-closet-de-la-ciela.webp' | asset_url }}" type="image/webp">

  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@400;500&family=Syncopate:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --deep: {{ settings.color_deep }};
      --accent: {{ settings.color_accent }};
      --pop: {{ settings.color_pop }};
      --mint: {{ settings.color_mint }};
      --bg: {{ settings.color_bg }};
      --logo-w: {{ settings.logo_width }}px;
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handleize }}">
  <a class="skip" href="#main">{{ 'general.skip' | t }}</a>

  {% sections 'header-group' %}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
